# LLM Control Plane — environment variables
# Copy this to .env and fill in your key

# Master key used to encrypt provider credentials stored via the dashboard UI.
# Set this to a stable random value (e.g. `openssl rand -base64 32`)
# so encrypted keys survive container restarts and are portable across hosts.
# If unset, a random key is generated at data/.lcp_secret_key (gitignored).
LCP_SECRET_KEY=change-me-to-a-long-random-string

# Provider API keys are managed via the dashboard (Providers → Configuration tab)
# — they're encrypted with the master key above and stored in SQLite.
# No provider-specific env vars needed.

# OpenCode web cookie + workspace ID for subscription usage tracking are also
# managed via the dashboard (Usage → OpenCode tab) — encrypted, same as API keys.

# Comma-separated paths that serve the /models endpoint (default: /v1/models,/models)
# OAI Copilot queries /models without the /v1/ prefix — both are enabled by default.
# Set to /v1/models if you only need the standard OpenAI path.
LCP_MODELS_PATHS=/v1/models,/models