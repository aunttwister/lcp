# LLM Control Plane — environment variables
# Copy this to .env and fill in your keys

OPENCODE_API_KEY=sk-your-opencode-key
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenCode web cookie — for subscription usage tracking.
# Extract the "auth" cookie from opencode.ai in your browser's developer tools.
# This is a SENSITIVE credential — NEVER commit it to git or share it.
# OPENCODE_COOKIE=auth=your-session-token-here
# OPENCODE_WORKSPACE_ID=wrk_01KQC8G9SMSA83HEYVR1QSRX27

# Comma-separated paths that serve the /models endpoint (default: /v1/models,/models)
# OAI Copilot queries /models without the /v1/ prefix — both are enabled by default.
# Set to /v1/models if you only need the standard OpenAI path.
LCP_MODELS_PATHS=/v1/models,/models