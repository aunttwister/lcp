[
 {
  "id": "px-200",
  "group": "proxy",
  "title": "a known profile answers 200",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"say ok\"}],\"max_tokens\":8}'); [ \"$c\" = \"200\" ] || [ \"$c\" = \"201\" ]"
 },
 {
  "id": "px-json",
  "group": "proxy",
  "title": "the reply is JSON with an OpenAI-shaped body",
  "cmd": "curl -q -s -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"say ok\"}],\"max_tokens\":8}' | python3 -c \"import sys,json; d=json.load(sys.stdin); assert 'choices' in d or 'error' in d, list(d)\""
 },
 {
  "id": "px-unknown-profile",
  "group": "proxy",
  "title": "an authenticated unknown profile is 400, not a silent default",
  "cmd": "c=$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/nope/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"say ok\"}],\"max_tokens\":8}'); [ \"$c\" = \"400\" ]"
 },
 {
  "id": "px-unknown-profile-msg",
  "group": "proxy",
  "title": "the 400 names the bad profile",
  "cmd": "curl -s -X POST '{{BASE}}/nope/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"say ok\"}],\"max_tokens\":8}' | python3 -c \"import sys,json; d=json.load(sys.stdin); assert 'error' in d; assert 'nope' in d['error'], d['error']\""
 },
 {
  "id": "px-unknown-anon",
  "group": "proxy",
  "title": "anonymous unknown profile is 302, not a profile-enumeration oracle",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/nope/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"say ok\"}],\"max_tokens\":8}'); [ \"$c\" = \"302\" ]"
 },
 {
  "id": "px-malformed",
  "group": "proxy",
  "title": "a malformed body is 400, not 500",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: application/json' -d '{bad'); [ \"$c\" = \"400\" ]"
 },
 {
  "id": "px-unknown-model",
  "group": "proxy",
  "title": "an unknown model never 5xxes (chain fallback)",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"nope/nope\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4}'); [ \"$c\" != \"500\" ] && [ \"$c\" != \"000\" ]"
 },
 {
  "id": "px-content-type",
  "group": "proxy",
  "title": "a text/plain body is not accepted as JSON",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: text/plain' -d '{}'); [ \"$c\" != \"200\" ]"
 },
 {
  "id": "px-stream",
  "group": "proxy",
  "title": "stream=true returns SSE data frames",
  "cmd": "out=$(curl -q -s -N -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":6}'); echo \"$out\" | grep -q 'data:'"
 },
 {
  "id": "px-tools",
  "group": "proxy",
  "title": "a tools payload is accepted",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/l2/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"what is 2+2\"}],\"max_tokens\":8,\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"add\",\"parameters\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"number\"},\"b\":{\"type\":\"number\"}}}}}]}'); [ \"$c\" = \"200\" ] || [ \"$c\" = \"201\" ]"
 },
 {
  "id": "px-other-profile",
  "group": "proxy",
  "title": "a second profile routes too (l1)",
  "cmd": "c=$(curl -q -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/l1/chat/completions' -H 'Content-Type: application/json' -d '{\"model\":\"deepseek/deepseek-v4-flash\",\"messages\":[{\"role\":\"user\",\"content\":\"say ok\"}],\"max_tokens\":8}'); [ \"$c\" = \"200\" ] || [ \"$c\" = \"201\" ]"
 }
]