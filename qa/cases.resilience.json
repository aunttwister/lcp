[
 {
  "id": "rs-idem-_api_work_tasks_lite_1&states_in_progres",
  "group": "resilience",
  "title": "idempotent /api/work/tasks?lite=1&states=in_progress&per=5",
  "cmd": "a=$(curl -s '{{BASE}}/api/work/tasks?lite=1&states=in_progress&per=5' | md5sum); b=$(curl -s '{{BASE}}/api/work/tasks?lite=1&states=in_progress&per=5' | md5sum); [ \"$a\" = \"$b\" ]"
 },
 {
  "id": "rs-idem-_api_work_conversations_per_5",
  "group": "resilience",
  "title": "idempotent /api/work/conversations?per=5",
  "cmd": "a=$(curl -s '{{BASE}}/api/work/conversations?per=5' | md5sum); b=$(curl -s '{{BASE}}/api/work/conversations?per=5' | md5sum); [ \"$a\" = \"$b\" ]"
 },
 {
  "id": "rs-clamp-1",
  "group": "resilience",
  "title": "per=0/page=0 clamps safely (not 500)",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' '{{BASE}}/api/work/tasks?lite=1&states=all&per=0&page=0')\" != \"500\" ]"
 },
 {
  "id": "rs-clamp-2",
  "group": "resilience",
  "title": "invalid states falls back (not 500)",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' '{{BASE}}/api/work/tasks?lite=1&states=garbage&per=5')\" != \"500\" ]"
 },
 {
  "id": "rs-clamp-3",
  "group": "resilience",
  "title": "negative pagination clamps (not 500)",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' '{{BASE}}/api/work/conversations?per=-3&page=-2')\" != \"500\" ]"
 },
 {
  "id": "rs-clamp-4",
  "group": "resilience",
  "title": "huge per/page clamps (not 500)",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' '{{BASE}}/api/work/tasks?lite=1&states=all&per=99999&page=99999')\" != \"500\" ]"
 },
 {
  "id": "rs-json-11",
  "group": "resilience",
  "title": "JSON error body for /api/work/tasks/detail?task=in_progress%2Fmi",
  "cmd": "code=$(curl -s -o /dev/null -w '{{HTTP}}' '{{BASE}}/api/work/tasks/detail?task=in_progress%2Fmissing-x'); [ \"$code\" != \"200\" ] && curl -s '{{BASE}}/api/work/tasks/detail?task=in_progress%2Fmissing-x' | python3 -c 'import sys,json; json.load(sys.stdin)'"
 },
 {
  "id": "rs-json-12",
  "group": "resilience",
  "title": "unknown conversation cid -> 200 JSON (by design)",
  "cmd": "curl -s '{{BASE}}/api/work/conversations/detail?cid=missing' | python3 -c 'import sys,json; d=json.load(sys.stdin); assert \"events\" in d'"
 },
 {
  "id": "rs-para-1",
  "group": "resilience",
  "title": "5 parallel lite fetches all succeed",
  "cmd": "for i in 1 2 3 4 5; do ( curl -s -o /dev/null -w '{{HTTP}}' '{{BASE}}/api/work/tasks?lite=1&states=in_progress&per=10' & ) ; done; wait 2>/dev/null; echo ok"
 }
]