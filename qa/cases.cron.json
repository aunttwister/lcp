[
 {
  "id": "cr-001",
  "group": "cron-sources",
  "title": "cron view counts sane",
  "cmd": "curl -s '{{BASE}}/api/work/cron' | python3 -c \"import sys,json; d=json.load(sys.stdin); assert d['available'] is True; assert d['counts']['total']>0\""
 },
 {
  "id": "cr-002",
  "group": "cron-sources",
  "title": "cron ops list empty-pending",
  "cmd": "curl -s '{{BASE}}/api/work/cron/ops' | python3 -c \"import sys,json; d=json.load(sys.stdin); assert 'pending' in d and 'done' in d\""
 },
 {
  "id": "cr-003",
  "group": "cron-sources",
  "title": "ops spool dir writable (POST surface)",
  "cmd": "[ -d /your/data/app/lcp/cron-ops/ops ] && [ -d /your/data/app/lcp/cron-ops/done ]"
 },
 {
  "id": "cr-010",
  "group": "cron-sources",
  "title": "reject: unknown action",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"explode\\\", \\\"profile\\\": \\\"backups\\\"}')\" = \"400\" ]"
 },
 {
  "id": "cr-011",
  "group": "cron-sources",
  "title": "reject: unknown profile",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"remove\\\", \\\"profile\\\": \\\"nope-profile\\\", \\\"job_id\\\": \\\"a1b2c3d4e5f6\\\"}')\" = \"400\" ]"
 },
 {
  "id": "cr-012",
  "group": "cron-sources",
  "title": "reject: create without prompt/script",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"create\\\", \\\"profile\\\": \\\"backups\\\", \\\"name\\\": \\\"x\\\", \\\"schedule\\\": \\\"30m\\\"}')\" = \"400\" ]"
 },
 {
  "id": "cr-013",
  "group": "cron-sources",
  "title": "reject: script with slash",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"create\\\", \\\"profile\\\": \\\"backups\\\", \\\"name\\\": \\\"x\\\", \\\"schedule\\\": \\\"30m\\\", \\\"script\\\": \\\"../evil.sh\\\"}')\" = \"400\" ]"
 },
 {
  "id": "cr-014",
  "group": "cron-sources",
  "title": "reject: edit empty fields",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"edit\\\", \\\"profile\\\": \\\"backups\\\", \\\"job_id\\\": \\\"a1b2c3d4e5f6\\\", \\\"fields\\\": {}}')\" = \"400\" ]"
 },
 {
  "id": "cr-015",
  "group": "cron-sources",
  "title": "reject: bad deliver",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"create\\\", \\\"profile\\\": \\\"backups\\\", \\\"name\\\": \\\"x\\\", \\\"schedule\\\": \\\"30m\\\", \\\"prompt\\\": \\\"p\\\", \\\"deliver\\\": \\\"nowhere\\\"}')\" = \"400\" ]"
 },
 {
  "id": "cr-016",
  "group": "cron-sources",
  "title": "reject: workdir outside /your/data",
  "cmd": "[ \"$(curl -s -o /dev/null -w '{{HTTP}}' -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\\\"action\\\": \\\"create\\\", \\\"profile\\\": \\\"backups\\\", \\\"name\\\": \\\"x\\\", \\\"schedule\\\": \\\"30m\\\", \\\"prompt\\\": \\\"p\\\", \\\"workdir\\\": \\\"/etc\\\"}')\" = \"400\" ]"
 },
 {
  "id": "cr-020",
  "group": "cron-sources",
  "title": "create op accepted (backups)",
  "cmd": "op=$(curl -s -X POST '{{BASE}}/api/work/cron/ops' -H 'Content-Type: application/json' -d '{\"action\":\"create\",\"profile\":\"backups\",\"name\":\"qa-suite-probe\",\"schedule\":\"2033-01-01T00:00:00\",\"prompt\":\"qa probe - safe to delete\",\"deliver\":\"local\"}'); echo \"$op\" | python3 -c 'import sys,json; d=json.load(sys.stdin); assert d.get(\"status\")==\"pending\", d'"
 }
]